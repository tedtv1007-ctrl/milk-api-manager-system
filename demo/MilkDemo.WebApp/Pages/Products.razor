@page "/products"
@inject IProductApiService ProductApi

<PageTitle>Products - Milk Demo</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h1 class="page-title" style="margin-bottom:0">📦 Products</h1>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ New Product</button>
</div>

<div style="display:flex;gap:12px;margin-bottom:16px">
    <select class="form-control" style="width:200px" @onchange="OnCategoryChanged">
        <option value="">All Categories</option>
        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <option value="@cat">@cat</option>
            }
        }
    </select>
</div>

@if (isLoading)
{
    <div class="loading">Loading products...</div>
}
else if (products != null)
{
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products.Items)
                {
                    <tr>
                        <td style="font-family:var(--font-mono)">@p.Id</td>
                        <td><strong>@p.Name</strong></td>
                        <td style="color:var(--text-secondary);max-width:200px;overflow:hidden;text-overflow:ellipsis">@p.Description</td>
                        <td>@p.Category</td>
                        <td style="font-family:var(--font-mono)">$@p.Price.ToString("N2")</td>
                        <td style="font-family:var(--font-mono)">@p.StockQuantity</td>
                        <td>
                            <span class="status-badge @(p.IsActive ? "status-online" : "status-offline")">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-outline btn-sm" @onclick="() => ShowEditDialog(p)">Edit</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteProduct(p.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(currentPage <= 1)">← Prev</button>
            <span class="page-info">Page @currentPage of @products.TotalPages (@products.TotalCount total)</span>
            <button @onclick="NextPage" disabled="@(currentPage >= products.TotalPages)">Next →</button>
        </div>
    </div>
}

@if (showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation>
            <h3 class="modal-title">@(isEditing ? "Edit Product" : "New Product")</h3>
            <div class="form-group">
                <label>Name</label>
                <input class="form-control" @bind="editModel.Name" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <input class="form-control" @bind="editModel.Description" />
            </div>
            <div class="grid-2">
                <div class="form-group">
                    <label>Price</label>
                    <input class="form-control" type="number" step="0.01" @bind="editModel.Price" />
                </div>
                <div class="form-group">
                    <label>Stock</label>
                    <input class="form-control" type="number" @bind="editModel.StockQuantity" />
                </div>
            </div>
            <div class="form-group">
                <label>Category</label>
                <input class="form-control" @bind="editModel.Category" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="CloseDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveProduct">@(isEditing ? "Update" : "Create")</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<Product>? products;
    private List<string>? categories;
    private int currentPage = 1;
    private string? selectedCategory;
    private bool isLoading = true;
    private bool showDialog;
    private bool isEditing;
    private int editingId;

    private ProductFormModel editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        products = await ProductApi.GetProductsAsync(currentPage, 10, selectedCategory);
        isLoading = false;
    }

    private async Task LoadCategories()
    {
        categories = await ProductApi.GetCategoriesAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedCategory)) selectedCategory = null;
        currentPage = 1;
        await LoadProducts();
    }

    private async Task PrevPage() { if (currentPage > 1) { currentPage--; await LoadProducts(); } }
    private async Task NextPage() { if (products != null && currentPage < products.TotalPages) { currentPage++; await LoadProducts(); } }

    private void ShowCreateDialog()
    {
        isEditing = false;
        editModel = new ProductFormModel { Category = "General" };
        showDialog = true;
    }

    private void ShowEditDialog(Product p)
    {
        isEditing = true;
        editingId = p.Id;
        editModel = new ProductFormModel
        {
            Name = p.Name,
            Description = p.Description,
            Price = p.Price,
            StockQuantity = p.StockQuantity,
            Category = p.Category,
            IsActive = p.IsActive
        };
        showDialog = true;
    }

    private void CloseDialog() => showDialog = false;

    private async Task SaveProduct()
    {
        if (isEditing)
        {
            await ProductApi.UpdateProductAsync(editingId, new ProductUpdateDto
            {
                Name = editModel.Name,
                Description = editModel.Description,
                Price = editModel.Price,
                StockQuantity = editModel.StockQuantity,
                Category = editModel.Category,
                IsActive = editModel.IsActive
            });
        }
        else
        {
            await ProductApi.CreateProductAsync(new ProductCreateDto
            {
                Name = editModel.Name,
                Description = editModel.Description,
                Price = editModel.Price,
                StockQuantity = editModel.StockQuantity,
                Category = editModel.Category
            });
        }

        showDialog = false;
        await LoadProducts();
        await LoadCategories();
    }

    private async Task DeleteProduct(int id)
    {
        await ProductApi.DeleteProductAsync(id);
        await LoadProducts();
    }

    private class ProductFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public int StockQuantity { get; set; }
        public string Category { get; set; } = "General";
        public bool IsActive { get; set; } = true;
    }
}

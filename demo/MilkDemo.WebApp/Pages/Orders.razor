@page "/orders"
@inject IOrderApiService OrderApi
@inject IProductApiService ProductApi

<PageTitle>Orders - Milk Demo</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <h1 class="page-title" style="margin-bottom:0">🛒 Orders</h1>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ New Order</button>
</div>

<div style="display:flex;gap:12px;margin-bottom:16px">
    <select class="form-control" style="width:200px" @onchange="OnStatusChanged">
        <option value="">All Status</option>
        @foreach (var s in Enum.GetValues<OrderStatus>())
        {
            <option value="@s">@s</option>
        }
    </select>
</div>

@if (isLoading)
{
    <div class="loading">Loading orders...</div>
}
else if (orders != null)
{
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in orders.Items)
                {
                    <tr>
                        <td style="font-family:var(--font-mono)">@o.Id</td>
                        <td><strong>@o.CustomerName</strong></td>
                        <td style="color:var(--text-secondary)">@o.CustomerEmail</td>
                        <td style="font-family:var(--font-mono)">@o.Items.Count</td>
                        <td style="font-family:var(--font-mono)">$@o.TotalAmount.ToString("N2")</td>
                        <td><span class="status-badge status-@o.Status.ToString().ToLower()">@o.Status</span></td>
                        <td style="color:var(--text-secondary);font-size:12px">@o.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button class="btn btn-outline btn-sm" @onclick="() => ShowOrderDetail(o)">Detail</button>
                            @if (o.Status == OrderStatus.Pending)
                            {
                                <button class="btn btn-danger btn-sm" @onclick="() => CancelOrder(o.Id)">Cancel</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(currentPage <= 1)">← Prev</button>
            <span class="page-info">Page @currentPage of @orders.TotalPages (@orders.TotalCount total)</span>
            <button @onclick="NextPage" disabled="@(currentPage >= orders.TotalPages)">Next →</button>
        </div>
    </div>
}

@if (showDetail && selectedOrder != null)
{
    <div class="modal-overlay" @onclick="() => showDetail = false">
        <div class="modal-content" @onclick:stopPropagation>
            <h3 class="modal-title">Order #@selectedOrder.Id Detail</h3>
            <p><strong>Customer:</strong> @selectedOrder.CustomerName</p>
            <p><strong>Email:</strong> @selectedOrder.CustomerEmail</p>
            <p><strong>Phone:</strong> @(selectedOrder.CustomerPhone ?? "N/A")</p>
            <p><strong>Status:</strong> <span class="status-badge status-@selectedOrder.Status.ToString().ToLower()">@selectedOrder.Status</span></p>
            <hr style="border-color:var(--border-color);margin:12px 0" />
            <table class="data-table">
                <thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var item in selectedOrder.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td style="font-family:var(--font-mono)">@item.Quantity</td>
                            <td style="font-family:var(--font-mono)">$@item.UnitPrice.ToString("N2")</td>
                            <td style="font-family:var(--font-mono)">$@item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p style="text-align:right;font-family:var(--font-mono);font-size:18px;font-weight:bold;margin-top:12px">
                Total: $@selectedOrder.TotalAmount.ToString("N2")
            </p>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => showDetail = false">Close</button>
            </div>
        </div>
    </div>
}

@if (showCreateDialog)
{
    <div class="modal-overlay" @onclick="() => showCreateDialog = false">
        <div class="modal-content" @onclick:stopPropagation>
            <h3 class="modal-title">New Order</h3>
            <div class="form-group">
                <label>Customer Name</label>
                <input class="form-control" @bind="newOrder.CustomerName" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input class="form-control" type="email" @bind="newOrder.CustomerEmail" />
            </div>
            <div class="form-group">
                <label>Phone</label>
                <input class="form-control" @bind="newOrder.CustomerPhone" />
            </div>
            <div class="card-header" style="font-size:14px">Order Items</div>
            @if (availableProducts != null)
            {
                @foreach (var item in orderItems)
                {
                    <div class="grid-2" style="margin-bottom:8px">
                        <select class="form-control" @bind="item.ProductId">
                            <option value="0">Select Product</option>
                            @foreach (var p in availableProducts)
                            {
                                <option value="@p.Id">@p.Name ($@p.Price.ToString("N2"))</option>
                            }
                        </select>
                        <input class="form-control" type="number" min="1" @bind="item.Quantity" placeholder="Qty" />
                    </div>
                }
                <button class="btn btn-outline btn-sm" @onclick="AddOrderItem" style="margin-top:8px">+ Add Item</button>
            }
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => showCreateDialog = false">Cancel</button>
                <button class="btn btn-primary" @onclick="CreateOrder">Create Order</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<Order>? orders;
    private int currentPage = 1;
    private OrderStatus? statusFilter;
    private bool isLoading = true;
    private bool showDetail;
    private bool showCreateDialog;
    private Order? selectedOrder;
    private OrderCreateDto newOrder = new();
    private List<OrderItemCreateDto> orderItems = new() { new() { Quantity = 1 } };
    private List<Product>? availableProducts;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        orders = await OrderApi.GetOrdersAsync(currentPage, 10, statusFilter);
        isLoading = false;
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        statusFilter = string.IsNullOrEmpty(val) ? null : Enum.Parse<OrderStatus>(val);
        currentPage = 1;
        await LoadOrders();
    }

    private async Task PrevPage() { if (currentPage > 1) { currentPage--; await LoadOrders(); } }
    private async Task NextPage() { if (orders != null && currentPage < orders.TotalPages) { currentPage++; await LoadOrders(); } }

    private void ShowOrderDetail(Order o) { selectedOrder = o; showDetail = true; }

    private async Task CancelOrder(int id) { await OrderApi.CancelOrderAsync(id); await LoadOrders(); }

    private async Task ShowCreateDialog_()
    {
        newOrder = new();
        orderItems = new() { new() { Quantity = 1 } };
        var products = await ProductApi.GetProductsAsync(1, 100);
        availableProducts = products?.Items;
        showCreateDialog = true;
    }

    private async Task ShowCreateDialog()
    {
        await ShowCreateDialog_();
    }

    private void AddOrderItem() => orderItems.Add(new() { Quantity = 1 });

    private async Task CreateOrder()
    {
        newOrder.Items = orderItems.Where(i => i.ProductId > 0 && i.Quantity > 0).ToList();
        if (newOrder.Items.Count == 0) return;

        await OrderApi.CreateOrderAsync(newOrder);
        showCreateDialog = false;
        await LoadOrders();
    }
}

@page "/blacklist"
@using MilkAdminBlazor.Data
@inject ApisixService ApisixService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Large" Color="Color.Error" Class="mr-3" />
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold">IP Blacklist</MudText>
            <MudText Typo="Typo.body1" Class="text-muted">Enforce network-level restrictions by blocking malicious or unauthorized IP addresses.</MudText>
        </div>
    </div>

    <MudGrid>
        <!-- Add IP Card -->
        <MudItem xs="12" lg="4">
            <MudCard Elevation="4" Class="rounded-lg border-t-4 border-primary">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Ban New Entity</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="4">
                        <MudTextField @bind-Value="newIp" Label="IP Address / CIDR" Variant="Variant.Filled" Placeholder="e.g. 192.168.1.1" FullWidth="true" />
                        <MudTextField @bind-Value="reason" Label="Ban Reason" Variant="Variant.Filled" Placeholder="e.g. Brute-force attack" FullWidth="true" />
                        <MudDatePicker @bind-Date="expiresAt" Label="Auto-Unban Date (Optional)" Variant="Variant.Filled" Clearable="true" />
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add" OnClick="AddIp" Class="py-3">Confirm Block</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- List Table -->
        <MudItem xs="12" lg="8">
            <MudTable Items="@blacklistedIps" Hover="true" Bordered="false" Striped="true" Elevation="4" Loading="@loading" Class="rounded-lg">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Active Restrictions</MudText>
                    <MudSpacer />
                    <MudTextField T="string" Placeholder="Search list..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>IP / Range</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Expiration</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><code class="fw-bold text-primary">@context.IpOrCidr</code></MudTd>
                    <MudTd>@context.Reason</MudTd>
                    <MudTd>
                        @if (context.ExpiresAt.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">@context.ExpiresAt.Value.ToString("yyyy-MM-dd")</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">Permanent</MudChip>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Color="Color.Error" OnClick="@(() => RemoveIp(context.IpOrCidr))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-8 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                        <MudText Color="Color.Default">The perimeter is currently clear.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool loading = true;
    private List<ApisixService.BlacklistEntryDto> blacklistedIps = new();
    private string newIp = "";
    private string? reason = null;
    private DateTime? expiresAt = null;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        blacklistedIps = await ApisixService.GetBlacklistedIpsAsync();
        loading = false;
    }

    private async Task AddIp()
    {
        if (string.IsNullOrWhiteSpace(newIp))
        {
            Snackbar.Add("Please enter a valid IP address.", Severity.Warning);
            return;
        }
        await ApisixService.AddIpToBlacklistAsync(newIp, reason, null, expiresAt);
        Snackbar.Add($"IP {newIp} successfully blocked.", Severity.Success);
        newIp = ""; reason = null; expiresAt = null;
        await LoadData();
    }

    private async Task RemoveIp(string ip)
    {
        await ApisixService.RemoveIpFromBlacklistAsync(ip);
        Snackbar.Add($"IP {ip} restriction lifted.", Severity.Info);
        await LoadData();
    }
}

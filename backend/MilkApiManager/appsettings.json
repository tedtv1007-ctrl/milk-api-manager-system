{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://milk-admin-ui:8080"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=milk_db;Username=milk_user;Password=milk_password;SSL Mode=Disable;Maximum Pool Size=30;Minimum Pool Size=5;Connection Idle Lifetime=300"
  },
  "AuditLog": {
    "EnableDatabaseWrite": true,
    "IncludedActions": "All",
    "EnableLogstashShipping": true,
    "UseDurableShipping": true,
    "Outbox": {
      "PollIntervalSeconds": 10,
      "MaxAttempts": 8
    }
  },
  "Ldap": {
    "Host": "ldap.example.com",
    "Port": 389,
    "UseSsl": false,
    "BindDn": "cn=admin,dc=example,dc=com",
    "BindPassword": "admin_password",
    "SearchBase": "ou=groups,dc=example,dc=com",
    "GroupFilter": "(objectClass=groupOfUniqueNames)"
  },
  "Jwt": {
    "Issuer": "MilkApiManager",
    "Audience": "MilkApiClients",
    "ExpirationMinutes": 480,
    "Secret": ""
  },
  "Blacklist": {
    "PersistToDatabase": true
  },
  "Sync": {
    "Blacklist": {
      "UseOutbox": false,
      "EnableReconcile": false,
      "ReconcileIntervalSeconds": 120
    },
    "Outbox": {
      "PollIntervalSeconds": 10
    }
  },
  "Slo": {
    "WindowMinutes": 15
  },
  "Apisix": {
    "AdminUrl": "http://apisix:9180/apisix/admin/",
    "AdminKey": "",
    "PublicUrl": "http://apisix:9080"
  },
  "Prometheus": {
    "Url": "http://prometheus:9090"
  },
  "Auth": {
    "ApiAuthKey": "",
    "UseTestMode": false,
    "UseDemoAuth": false
  }
}
# Milk API Manager System - Environment Variables Template
# ========================================================
# Copy this file to .env and fill in your actual values.

# PostgreSQL
POSTGRES_USER=milk_user
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_DB=milk_db

# APISIX
APISIX_ADMIN_KEY=<your-apisix-admin-key>

# Backend API Authentication
API_AUTH_KEY=<your-api-auth-key>

# JWT Authentication
JWT_SECRET=<your-jwt-secret-at-least-32-characters>

# LDAP (Phase 7)
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=<your-ldap-password>

# Grafana
GF_SECURITY_ADMIN_PASSWORD=<your-grafana-password>
# Optional: set to your Slack/Webhook endpoint to receive SLO alert notifications
GRAFANA_SLO_WEBHOOK_URL=https://example.invalid/replace-with-real-webhook
